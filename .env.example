# Скопируйте в .env: cp .env.example .env
# Значения ниже работают как есть — менять ничего не нужно.
#
# ВАЖНО про адреса сервисов. Приложение запускается в compose и обращается
# к соседям по именам сервисов (postgres, redis, mailpit) — эти значения
# заданы прямо в docker-compose.yml и переопределяют то, что здесь.
# Переменные из этого файла нужны инструментам, которые запускаются НА ХОСТЕ:
# prisma CLI, миграции вручную, тесты. Поэтому здесь localhost, а не postgres.

# --- База данных ---
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_DB=crm
POSTGRES_PORT=5432
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm?schema=public

# Отдельная база для тестов: тесты чистят данные между кейсами,
# и делать это на базе с сидом разработчика нельзя.
TEST_DATABASE_URL=postgresql://crm:crm@localhost:5432/crm_test?schema=public

# --- Очередь ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Порт приложения на хосте ---
APP_PORT=8080

# --- Auth.js ---
# Сгенерировать: openssl rand -base64 32
AUTH_SECRET=dev-secret-change-me-openssl-rand-base64-32
AUTH_URL=http://localhost:8080
AUTH_TRUST_HOST=true

# --- Почта ---
# По умолчанию — Mailpit из docker-compose: письма видны на http://localhost:8025
# и не уходят наружу. В production Mailpit также доступен как тестовый режим,
# а настоящий SMTP выбирается и заполняется через wizard или настройки.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="Массажный салон <noreply@example.com>"
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAILPIT_MAX_MESSAGES=1000
MAILPIT_MAX_AGE=30d
